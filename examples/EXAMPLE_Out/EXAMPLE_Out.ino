#include <HANUMAN_32_mini.h>

//- ================================================================================================

void setup() 
{
  Serial.begin(115200);
}

void loop() 
{
  out(1, 1);
  out(2, 1);
  out(3, 1);
  out(4, 1);
  out(5, 1);
  out(6, 1);
  Serial.println("ALL ON");
  
  delay(1000);

  out(1, 0);
  out(2, 0);
  out(3, 0);
  out(4, 0);
  out(5, 0);
  out(6, 0);
  Serial.println("ALL OFF");
  
  delay(1000);

}

//- ================================================================================================
